# Telegram bot token from BotFather. Never commit your real token.
TELEGRAM_BOT_TOKEN=replace_me
LOG_LEVEL=INFO

# Public Supabase project URL and anon/publishable key only.
# Never use the service_role key in this Telegram bot.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_public_anon_key
